---
import Wrapper from '../layouts/wrapper.astro';
import Hero from '../components/Hero.astro';

import heroImage from '../assets/images/chrome/me-seated.png'

const breadcrumb = [
  { label: 'Home', href: '/', previous: true },
  { label: 'CV' },
];

---
<Wrapper
	title="Curriculum Vitae"
	description="Nick Clarkson’s curriculum vitae, covering over 25 years of experience in web development, technical leadership and digital strategy."
	image="/src/assets/images/country.jpg">

	<section class="section">
		<Hero
			backgroundImage={heroImage}
			breadcrumb={breadcrumb}
			title="Curriculum Vitae"
		/>
	</section>

	<section class="section typography measure">
		
	</section>			
</Wrapper>
