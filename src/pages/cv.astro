---
import Wrapper from '../layouts/wrapper.astro';
import Hero from '../components/Hero.astro';

import heroImage from '../assets/images/chrome/me-seated.png'
import pixelImage from '../assets/images/country.jpg';

const breadcrumb = [
  { label: 'Home', href: '/', previous: true },
  { label: 'CV' },
];

const experience = [
  {
    from: "Jan 2026",
    to: "Jul 2026",
    role: "Head of Development",
    company: "Beep Digital",
    description:
      "Building and leading the development team, shaping AI strategy and improving how creative, design and development work together to deliver ambitious digital experiences.",
  },
  {
    from: "Jul 2018",
    to: "Jan 2026",
    role: "Digital / Technical Director",
    company: "Halo",
    description:
      "Led digital strategy, technology and delivery across the agency, building teams and delivering award-winning work for clients including Live Nation, Ticketmaster and Turtle Bay.",
  },
  {
    from: "Feb 2016",
    to: "Jul 2018",
    role: "Head of Digital",
    company: "NMI",
    description:
      "Led digital strategy, UX, development and marketing automation through a period of growth and acquisition, including a website redevelopment that increased conversions by 300%.",
  },
  {
    from: "Nov 2014",
    to: "Feb 2015",
    role: "Technical Director",
    company: "AUK",
    description:
      "Led a growing development team and worked closely with clients to define and deliver technically ambitious digital projects.",
  },
  {
    from: "Nov 2012",
    to: "Nov 2014",
    role: "Head of Development",
    company: "G+V",
    description:
      "Led the agency's technical direction, development team and solutions approach while contributing to major national pitches.",
  },
  {
    from: "Nov 2011",
    to: "Nov 2012",
    role: "Senior Interface Developer",
    company: "Great State",
    description:
      "Built complex web and mobile experiences, led technical delivery and mentored developers across major client projects.",
  },
  {
    from: "Nov 2010",
    to: "Nov 2011",
    role: "Development Manager",
    company: "Digital Visitor",
    description:
      "Led development of an award-winning social and reviews platform, including its REST API, client integrations and JavaScript tooling.",
  },
  {
    from: "Nov 2007",
    to: "Nov 2011",
    role: "Freelance Web Developer / Designer",
    company: "Freelance",
    description:
      "Designed, developed and delivered digital products for organisations including Oracle, Oxford University and the NHS.",
  },
  {
    from: "Nov 2004",
    to: "Nov 2007",
    role: "Product Specialist",
    company: "Xpress Ordering",
    description:
      "Developed interactive kiosk products and supporting web systems for clients including Orange, NatWest, Lloyds and RBS.",
  },
  {
    from: "Nov 1999",
    to: "Nov 2004",
    role: "Web Developer / Designer",
    company: "Freelance",
    description:
      "Started my career designing and building websites and interactive experiences for SMEs and clients including Playboy UK and Gumball 3000.",
  },
];

const awards = [
  {
    year: 2025,
    award: "Web Excellence Awards",
    category: "Best Hotel & Hospitality",
    project: "Tregulland & Co.",
    company: "Halo",
  },
  {
    year: 2024,
    award: "Web Excellence Awards",
    category: "Best Recruitment Website",
    project: "Aspiration Training",
    company: "Halo",
  },
  {
    year: 2015,
    award: "The Drum Awards for Digital Industries",
    category: "Best Not-for-Profit Website",
    project: "The National Trust 50 Things",
    company: "Great State",
  },
  {
    year: 2011,
    award: "Travolution Awards",
    category: "Best Online Application",
    project: "Visitor Review",
    company: "Digital Visitor",
  },
  {
    year: 2010,
    award: "IVCA Awards",
    category: "Best Interactive",
    project: "Rethink eLearning Application",
    company: "Freelance",
  },
];

---
<Wrapper
	title="Curriculum Vitae"
	description="Nick Clarkson’s curriculum vitae, covering over 25 years of experience in web development, technical leadership and digital strategy."
	image={pixelImage}>

	<section class="section">
		<Hero
			backgroundImage={heroImage}
			breadcrumb={breadcrumb}
			title="Curriculum Vitae"
		/>
	</section>

  <section class="section measure typography">

    <h1>From building things to leading how they’re built.</h1>
    <p>I’ve spent my career working across development, design and digital leadership — leading teams, shaping digital strategy and turning ambitious ideas into things that can actually be delivered.</p>
    <h2>Want the full story?</h1>
    <p>Download my full CV for a more detailed look at my experience and career history.</p>
    <p><a href="/Nick-Clarkson-CV-2026.pdf" target="_blank">Download my CV</a></p>

  </section>

	<section class="section grid">

    <div class="grid__item grid__item--two-thirds">

      {experience.map(({ from, to, role, company, description }) => (		
        <div class="job">	
          <p class="job__duration nav__heading">{from} – {to}</p>
          <div class="job__details">
            <h3 class="job__title">{role}</h3>
            <p class="job__company">{company}</p>
            <p class="typography">{description}</p>
          </div>
        </div>
      ))}

    </div>

    <div class="grid__item grid__item--third">
			<h2 class="job__duration nav__heading">Awards</h2>

			{awards.map(({ year, award, category, project, company }) => (
				<div class="award">					
					<h3 class="award__category job__title"><span class="award__year">{year}</span> {category}</h3>	
          <div class="typography">
            <p class="award__title"><strong>{award}</strong><br>{company} / {project}</p>
          </div>
				</div>
			))}
    </div>

	</section>			
</Wrapper>
