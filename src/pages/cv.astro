---
import Wrapper from '../../layouts/wrapper.astro';
import Hero from '../../components/Hero.astro';

import heroImage from '../../assets/images/chrome/me-seated.png'

const breadcrumb = [
  { label: 'Home', href: '/' },
  { label: 'Curriculum Vitae' },
];

---
<Wrapper
	title="AI"
	description="Nick Clarkson—creative technologist, digital strategist, and agency leader—combining technical expertise with a user-centred approach to build meaningful digital work."
	image="/src/assets/images/country.jpg">

	<section class="section">
		<Hero
			backgroundImage={heroImage}
			breadcrumb={breadcrumb}
			title="Curriculum Vitae"
		/>
	</section>

	<section class="section typography measure">
		
	</section>			
</Wrapper>