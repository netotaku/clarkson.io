---
import { type CollectionEntry, getCollection } from 'astro:content';
import Wrapper from '../../layouts/wrapper.astro';
import { render } from 'astro:content';
import Hero from '../../components/Hero.astro';
import {
  WhatsappIcon,
  PhoneIcon,
  EmailIcon,
} from '../../icons';

import bikeImage from '../../assets/images/chrome/me-on-a-bike.png';

import Header from '../../components/fragments/Header.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: {
			...post,
			data: post.data,
		}
	}));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id) // exclude current post
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()) // newest first
  .slice(0, 2); // limit to 2

const breadcrumb = [
  { label: 'Blog', href: '/blog/', previous: true },
  { label: post.data.title },
];
---
<Wrapper
	title={post.data.title}
	description={post.data.description}
	image={post.data.heroImage} >

	<section class="section">
		<Hero
			backgroundImage={bikeImage}
			breadcrumb={breadcrumb}
			title="Thoughts"
		/>
	</section>

	<div class="section blog grid">
		
		<header class="blog__header grid__item grid__item--third">

			<Header post={post} />

			<div class="blog__header__hire-me">
				<h2>Hire Me</h2>
				<p>{post.data.cta}</p>
			</div>

			<h3>Let's talk.</h3>

			<div class="blog__header__icons">				
				<a class="btn btn--icon btn--whatsapp" href="#"><WhatsappIcon /></a>
				<a class="btn btn--icon btn--phone" href="#"><PhoneIcon /></a>
				<a class="btn btn--icon btn--email" href="#"><EmailIcon /></a>
			</div>	

		</header>
		<div class="blog__content typography grid__item grid__item--two-thirds">
			<Content />
		</div>
	</div>			
		
</Wrapper>
