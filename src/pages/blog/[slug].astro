---
import { type CollectionEntry, getCollection } from 'astro:content';
import Wrapper from '../../layouts/wrapper.astro';
import { render } from 'astro:content';
import FormattedDate from '../../components/helpers/FormattedDate.astro'; 
import Hero from '../../components/Hero.astro';
import {
  WhatsappIcon,
  PhoneIcon,
  EmailIcon,
} from '../../icons';

import bikeImage from '../../assets/images/chrome/me-on-a-bike.png';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: {
			...post,
			data: post.data,
		}
	}));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id) // exclude current post
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()) // newest first
  .slice(0, 2); // limit to 2

const breadcrumb = [
  { label: 'Home', href: '/' },
  { label: 'Blog', href: '/blog/' },
  { label: post.data.title },
];
---
<Wrapper
	title={post.data.title}
	description={post.data.description}
	image={post.data.heroImage} >

	<section class="section">
		<Hero
			backgroundImage={bikeImage}
			breadcrumb={breadcrumb}
			title="Thoughts"
		/>
	</section>

	<div class="section blog">
		
		<header class="blog__header">

			<div class="blog__header__details">
				<div class="blog__header__eyebrow">
					<FormattedDate date={post.data.pubDate} />
					
				</div>
			</div>

			<p class="blog__header__desc">{post.data.description}</p>

			<div class="blog__header__tags">
				{post.data.categories?.map((category) => (
					<a class="tag" href="#">
						<span class="tag__count">#</span>
						<span class="tag__label">{category}</span>
					</a>
				))}
			</div>

			<div class="blog__header__hire-me">
				<h2>Hire Me</h2>
				<p>{post.data.cta}</p>
			</div>

			<h3>Let's talk.</h3>

			<div class="blog__header__icons">				
				<a class="btn btn--icon btn--whatsapp" href="#"><WhatsappIcon /></a>
				<a class="btn btn--icon btn--phone" href="#"><PhoneIcon /></a>
				<a class="btn btn--icon btn--email" href="#"><EmailIcon /></a>
			</div>	

		</header>
		<div class="blog__content typography">
			<Content />
		</div>
	</div>			
		
</Wrapper>
