---
import { getCollection } from 'astro:content';
import Archive from '../../../layouts/archive.astro';
import { categoryLabel, categorySlug } from '../../../utils/categories';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  const categories = new Set(
    posts.flatMap((post) =>
      post.data.categories?.map(categorySlug) || []
    )
  );

  return Array.from(categories).map((category) => ({
    params: { category },
    props: { category },
  }));
}

const routeCategory = Astro.props.category;
const routeCategoryLabel = categoryLabel(routeCategory);

const allPosts = await getCollection('blog');

const posts = allPosts.filter((post) =>
  post.data.categories.some(
    (category) => categorySlug(category) === routeCategory
  )
);
---
<Archive
  title={`#${routeCategoryLabel}`}
  description={`Posts in the category: ${routeCategoryLabel}`}
  image="/images/bio.jpg"
  breadcrumb={[
    { label: 'Blog', href: '/blog/', previous: true },
    { label: `#${routeCategoryLabel}` },
  ]}
  posts={posts}
/>
