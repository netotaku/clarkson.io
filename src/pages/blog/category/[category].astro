---
import { getCollection } from 'astro:content';
import Archive from '../../../layouts/archive.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  const categories = new Set(
    posts.flatMap((post) =>
      post.data.categories?.map((c) => c.toLowerCase()) || []
    )
  );

  return Array.from(categories).map((category) => ({
    params: { category },
    props: { category },
  }));
}

const routeCategory = Astro.props.category.toLowerCase();

const allPosts = await getCollection('blog');

const posts = allPosts.filter((post) =>
  post.data.categories.some(
    (c) => c.toLowerCase() === routeCategory
  )
);
---
<Archive
  title={`#${routeCategory}`}
  heading={`#${routeCategory}`}
  description={`Posts in the category: ${routeCategory}`}
  image="/images/bio.jpg"
  posts={posts}
/>
