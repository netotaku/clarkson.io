---
import { getCollection } from 'astro:content';
import Hero from '../../../components/Hero.astro';
import Wrapper from '../../../layouts/wrapper.astro';
import bikeImage from '../../../assets/images/chrome/me-on-a-bike.png';
import pixelImage from '../../../assets/images/dev.jpg';
import { categoryLabel, categorySlug } from '../../../utils/categories';

const posts = await getCollection('blog');

const allCategories = Array.from(new Set(
  posts.flatMap((post) => post.data.categories.map(categorySlug)),
)).sort();

const categories = allCategories.map((category) => ({
  slug: category,
  label: categoryLabel(category),
  count: posts.filter((post) =>
    post.data.categories.some(
      (postCategory) => categorySlug(postCategory) === category,
    ),
  ).length,
}));
---
<Wrapper
  title="Blog topics"
  description="Browse articles by topic, including ethical technology, accessibility, AI, web development and digital strategy."
  image={pixelImage}
>
  <section class="section">
    <Hero
      backgroundImage={bikeImage}
      breadcrumb={[
        { label: 'Blog', href: '/blog/', previous: true },
        { label: 'Topics' },
      ]}
      title="Topics"
    />
  </section>

  <section class="section measure">
    <nav aria-label="Blog topics">
      {categories.map((category) => (
        <a
          class="tag tag--inline tag--large"
          href={`/blog/category/${category.slug}/`}
        >
          <span class="tag__count">{category.count}</span>
          <span class="tag__label">{category.label}</span>
        </a>
      ))}
    </nav>
  </section>
</Wrapper>
