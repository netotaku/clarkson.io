---
import Wrapper from '../layouts/wrapper.astro';
import Hero from '../components/Hero.astro';

import heroImage from '../assets/images/chrome/me-seated.png'

const breadcrumb = [
  { label: 'Home', href: '/', previous: true },
  { label: 'Where I Fit' },
];

---
<Wrapper
	title="Where I Fit"
	description="Where Nick Clarkson’s experience in creative technology, technical leadership and digital strategy can add the most value."
	image="/src/assets/images/river.jpg">

	<section class="section">
		<Hero
			backgroundImage={heroImage}
			breadcrumb={breadcrumb}
			title="Where I Fit"
		/>
	</section>
	
	<section class="section typography measure">
		
	</section>			
</Wrapper>
