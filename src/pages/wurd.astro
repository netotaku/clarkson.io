---
import Wrapper 	from '../layouts/wrapper.astro';
import Wurd from '../components/Wurd.vue';
import { HeartIcon } from '../icons';
---
<Wrapper
	title="Nick Clarkson, Creative Technologist, Bristol UK"
	description="Nick is a digital consultant with over 20 years of experience in web development, project management, and CRM systems. He helps organisations navigate digital complexity with clarity and confidence."
	image='/src/assets/images/space.jpg'>
	
    <section class="section section--wurd">
        <div class="wurd">
            <div class="wurd__game">
                <Wurd
                    client:visible
                    endpoint="/.netlify/functions/quote"
                    startingLives={4}
                    starterVowels={2}
                    starterConsonants={2}
                    instancesPerStarter={2}
                    autoNextDelay={500}
                    useMockQuote={import.meta.env.DEV}
                >
                    <HeartIcon slot="lives-icon" />
                </Wurd>
            </div>
        </div>
    </section>
</Wrapper>
