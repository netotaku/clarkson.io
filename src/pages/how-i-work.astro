---
import Wrapper from '../layouts/wrapper.astro';
import Hero from '../components/Hero.astro';

import heroImage from '../assets/images/chrome/me-seated.png'

const breadcrumb = [
  { label: 'Home', href: '/', previous: true },
  { label: 'How I Work' },
];

---
<Wrapper
	title="How I Work"
	description="How Nick Clarkson combines technical expertise, creative thinking and a user-centred approach to deliver meaningful digital work."
	image="/src/assets/images/jungle.avif">

	<section class="section">
		<Hero
			backgroundImage={heroImage}
			breadcrumb={breadcrumb}
			title="How I Work"
		/>
	</section>
	
	<section class="section typography measure">
		
	</section>			
</Wrapper>
