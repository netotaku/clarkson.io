---
import { getCollection } from 'astro:content';
import HeaderLink from '../components/HeaderLink.astro';
import Wrapper from '../layouts/wrapper.astro';
import BlogList from '../components/BlogList.astro';
import BlogHero from '../components/BlogHero.astro';
import BlogCal from '../components/BlogCal.astro';
import '../styles/global.scss';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featured = posts.shift();
const main = posts;
const secondary = posts.splice(0,2);
---
<html>
	<head>
		<!-- Global Metadata -->
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<!-- <link rel="icon" type="image/svg+xml" href="/images/favicon.png" /> -->
		<link rel="sitemap" href="/sitemap-index.xml" />

		<!-- <link
  			rel="stylesheet"
  			href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"
		> -->
	</head>
	<body>

		<article class="layout">

			Hello

		</article>


		<aside class="menu">

			<div class="menu__row">

				<HeaderLink  
					href="/">Home</HeaderLink>
				<HeaderLink
					href="/blog">Blog</HeaderLink>
				<HeaderLink 
					href="/about">About</HeaderLink>
				<HeaderLink     
					href="/contact">Contact</HeaderLink>

			</div>

			<BlogList 
				title="Insights" 
				posts={posts}
				modifier="__sidebar" />
		</aside>


		<!-- <script async src="https://eocampaign1.com/form/1aef13f2-57f1-11f0-8302-410f126a741a.js" data-form="1aef13f2-57f1-11f0-8302-410f126a741a"></script> -->
	</body>
</html>
