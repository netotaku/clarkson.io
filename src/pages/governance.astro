---
import Wrapper from '../layouts/wrapper.astro';
import Hero from '../components/Hero.astro';

import heroImage from '../assets/images/chrome/me-seated.png'

const breadcrumb = [
  { label: 'Home', href: '/', previous: true },
  { label: 'AI Governance' },
];

---
<Wrapper
	title="AI Governance"
	description="Practical AI governance guidance for adopting artificial intelligence responsibly, transparently and effectively."
	image="/src/assets/images/times-sq.jpg">

	<section class="section">
		<Hero
			backgroundImage={heroImage}
			breadcrumb={breadcrumb}
			title="AI Governance"
		/>
	</section>

	<section class="section typography measure">
		
	</section>			
</Wrapper>
