---
import Wrapper 	from '../layouts/wrapper.astro';
import Card from '../components/Card.astro';
import { Image } from 'astro:assets';
import me from '../assets/images/chrome/me-crossed-arms.png';
import pixelImage from '../assets/images/more-jungle.jpg';
import { getLatestPost } from '../utils/blog';

const latestPost = await getLatestPost();
---
<Wrapper
	title="Nick Clarkson, Creative Technologist, Bristol UK"
	description="Nick Clarkson is a Bristol-based creative technologist and technical leader with over 25 years of experience in web development and digital strategy."
	image={pixelImage}>

	<section class="section home">

		<Image
			src={me}
			alt="Clarky"	
			width={500}
			class="home__me"
		/>

		<div class="home__lockup">

			<div class="home__lockup__latest">
				<h2 class="eyebrow">Latest post</h2>
				<Card post={latestPost} modifier="--micro" />
			</div>

			<h1 class="home__lockup__heading">Nick<br>Clarkson</h1>

			<div class="measure typography">

				<p><strong>I’ve spent more than 25 years working on the web</strong> — from hands-on development and design to leading teams and shaping digital strategy.</p>

				<nav class="home__nav">
					<a href="/cv">Curriculum Vitae</a>
					<a href="/governance">AI Governence</a>
					<a href="/blog">Thoughts</a>
				</nav>

			</div>
			
		</div>

	</section>

</Wrapper>
