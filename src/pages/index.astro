---
import { getCollection } from 'astro:content';
import Wrapper 	from '../layouts/wrapper.astro';
import BlogList from '../components/BlogList.astro';
import CV 		from '../components/CV.astro';
import Services from '../components/Services.astro';
import Socials 	from '../components/Socials.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

---
<Wrapper
	title="Nick Clarkson, Creative Technologist, Bristol UK"
	description="Nick is a digital consultant with over 20 years of experience in web development, project management, and CRM systems. He helps organisations navigate digital complexity with clarity and confidence."
	image='/src/assets/images/bio.jpg'>
	<div class="u-blank"></div>
</Wrapper>