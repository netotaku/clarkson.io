---
import Wrapper 	from '../layouts/wrapper.astro';
import Card from '../components/Card.astro';
import List from '../components/List.astro';
import Primary from '../components/nav/primary.astro';
import { Image } from 'astro:assets';
import me from '../assets/images/chrome/me-crossed-arms.png';
import pixelImage from '../assets/images/more-jungle.jpg';
import { getLatestPosts } from '../utils/blog';

const latestPosts = await getLatestPosts(3);
const [latestPost] = latestPosts;
---
<Wrapper
	title="Nick Clarkson, Creative Technologist, Bristol UK"
	description="Nick Clarkson is a Bristol-based creative technologist and technical leader with over 25 years of experience in web development and digital strategy."
	image={pixelImage}>

	<section class="section home">

		<Image
			src={me}
			alt="Clarky"	
			width={500}
			class="home__me"
		/>

		<div class="home__lockup">

			<div class="home__lockup__latest">
				<h2 class="eyebrow">Latest post</h2>
				<Card post={latestPost} modifier="--micro" />
			</div>

			<h1 class="home__lockup__heading">Nick<br>Clarkson</h1>

			<div class="measure typography">

				<p class="home__lockup__description"><strong>I’ve spent more than 25 years working on the web</strong> — designing and building websites, leading development teams, shaping digital strategy and helping organisations turn ambitious ideas into things that work.</p>

				<nav class="home__nav">
					<Primary showHeading={false} />
					<a href="/governance">AI Governence</a>
					<a href="/cv">Curriculum Vitae</a>					
				</nav>

			</div>
							
				<List posts={latestPosts} />
				<p><a class="home__blog-link" href="/blog">Read more thoughts</a></p>
			
		</div>

	</section>

</Wrapper>
