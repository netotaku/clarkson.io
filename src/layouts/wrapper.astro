---
import { SITE_TITLE } from  '../consts';
import type { ImageMetadata } from 'astro';
import { ClientRouter } from 'astro:transitions';
import oswaldFont from '../assets/fonts/oswald/oswald-latin-700.woff2?url';
import robotoFont from '../assets/fonts/roboto/roboto-latin-variable.woff2?url';
import PixelHero from "../components/PixelHero.astro";
import Card from "../components/Card.astro";


import Primary from "../components/nav/primary.astro";
import Secondary from "../components/nav/secondary.astro";
import Social from "../components/nav/social.astro";
import Contact from "../components/nav/contact.astro";



import SignUp from "../components/fragments/SignUp.astro";
import { getCollection } from 'astro:content';
import '../styles/global.scss';
import {
  BurgerIcon,
  WhatsappIcon,
  HomeIcon
} from '../icons';

const today = new Date();

interface Props {
	title?: string;
	description?: string;
	image: string | ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image } = Astro.props;
const imageUrl = typeof image === 'string' ? image : image.src;

const allPosts = await getCollection('blog');
const latestPost = [...allPosts].sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)[0];


const categoryMap = new Map<
  string,
  {
    slug: string;
    label: string;
    count: number;
  }
>();

const unslugify = (slug: string) =>
  slug
    .replace(/[-_]+/g, ' ')
    .replace(/\b\w/g, (char) => char.toUpperCase());

for (const post of allPosts) {
  for (const slug of post.data.categories ?? []) {
    const existing = categoryMap.get(slug);

    if (existing) {
      existing.count += 1;
    } else {
      categoryMap.set(slug, {
        slug,
        label: unslugify(slug),
        count: 1,
      });
    }
  }
}
const categories = [...categoryMap.values()]
  .sort((a, b) => b.count - a.count);
---
<!doctype html>
<html lang="en-GB" transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link
			rel="preload"
			href={oswaldFont}
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		<link
			rel="preload"
			href={robotoFont}
			as="font"
			type="font/woff2"
			crossorigin="anonymous"
		/>
		<script is:inline>
			document.documentElement.classList.add(
				'font-oswald-loading',
				'font-roboto-loading',
				'hero-initial-load',
			);
		</script>
		<link rel="icon" type="image/svg+xml" href="/images/favicon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={SITE_TITLE}
			href={new URL('rss.xml', Astro.site)}
		/>
		<meta name="generator" content="ZX Spectrum 128 +2" />
		<ClientRouter fallback="swap" />
		<link rel="canonical" href={canonicalURL} />

		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(imageUrl, Astro.url)} />
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(imageUrl, Astro.url)} />
		
	</head>
	<body>
		<div
			class="navigation-progress"
			data-navigation-progress
			transition:persist="navigation-progress"
			aria-hidden="true"
		></div>
		
		<nav class="layer layer--0 nav">
			<div class="nav__section">
				<Primary />
			</div>
			<div class="nav__section">
				<Secondary />
			</div>
			<div class="nav__section">
				<Contact />	
			</div>				
			<div class="nav__section">
				<Social />
			</div>		
			<div class="nav__section">
				<h2 class="nav__heading"># Topics</h2>
				{categories.map((category) => (
					<a
						href={`/blog/category/${category.slug}/`}
						class="tag tag--stacked">					
							<span class="tag__count">{category.count}</span>
							<span class="tag__label">{category.label}</span>
					</a>
				))}
			</div>			
		</nav>

		<div class="main">

			<div class="layer layer--1">

				<PixelHero
					src={image}
					topHeight={1200}
					pixelPitch={44}
					dotScale={.9}
					cornerRadius={28}
					backgroundSample="average"
					backgroundMix={0.29}
					parallax={true}
					parallaxSpeed={0.3}
					physics="chunky-collapse"
					entranceStyle="grow"
					physicsOverrides={{

						dissolveStart: .1,
						erosion: 0.9,
						cohesion: 0.66,
						gravity: 2.25,
						turbulence: 0.04,
						drag: 0.22,
						fragmentDistance: 4000,
						tailOpacity: 1,
						tailFadeCurve: 1,
						seed: 911,

					}}
					
				/>

			</div>
	
			<main class="layer layer--2">

				<slot />
				
				<footer class="section footer">
					<div class="">
			
					</div>

					<div class="footer__links footer__links--primary">										
						<div class="footer__links__list">
							<Primary />
						</div>

					</div>

					<div class="footer__links">	
						<div class="footer__links__list">
							<Secondary />
						</div>
						<div class="footer__links__list">
							<Social />
						</div>
						<div class="footer__links__list">
							<Contact />
						</div>
						<div class="footer__links__list footer__links__list--latest">
							<h2 class="nav__heading">Latest Post</h2>
							<Card post={latestPost} modifier="--mini" />
						</div>
					</div>
					
					<SignUp />	

					<p><a class="footer__cookies" href="/cookies-and-privacy">Cookies &amp; Privacy</a></p>
					
				</footer>

			</main>

		</div> <!-- .main -->

		<menu
			class="menu"
			transition:persist="fixed-menu"
		>
			<div class="menu__group">
				<a class="btn btn--icon" href="/">
					<HomeIcon />
				</a>

				<div class="btn btn--green">
					<span class="btn__circle"></span> Available for work
				</div>
			</div>
			<div class="menu__group">
				<a class="btn btn--icon" href="#">
					<WhatsappIcon />
				</a>
				<a id="js-open-closed" class="btn btn--icon">
					<BurgerIcon />
				</a>
			</div>
		</menu>

		<script src="https://cdn.counter.dev/script.js" data-id="59f59e50-b01a-493b-a121-d8237b9db371" data-utcoffset="1"></script>
		<script>
			const pageFadeDuration = 520;
			const minimumNavigationDuration = pageFadeDuration;
			const initialHeroFadeDuration = pageFadeDuration;
			let heroRevealVersion = 0;

			const waitForPixelHero = () => {
				const pixelHero = document.querySelector<HTMLElement>('[data-pixel-hero]');

				if (!pixelHero || pixelHero.classList.contains('is-ready')) {
					return Promise.resolve();
				}

				return new Promise<void>((resolve) => {
					const finish = () => {
						observer.disconnect();
						window.clearTimeout(timeout);
						resolve();
					};

					const observer = new MutationObserver(() => {
						if (pixelHero.classList.contains('is-ready')) finish();
					});

					const timeout = window.setTimeout(finish, 2000);
					observer.observe(pixelHero, { attributes: true, attributeFilter: ['class'] });

					if (pixelHero.classList.contains('is-ready')) finish();
				});
			};

			const revealInitialHero = async () => {
				const version = ++heroRevealVersion;

				try {
					await Promise.all([
						document.fonts.load('700 1em Oswald'),
						document.fonts.load('400 1em Roboto'),
						waitForPixelHero(),
					]);
				} finally {
					if (version !== heroRevealVersion) return;

					document.documentElement.classList.remove('font-oswald-loading');
					document.documentElement.classList.remove('font-roboto-loading');

					window.requestAnimationFrame(() => {
						if (version !== heroRevealVersion) return;

						window.requestAnimationFrame(() => {
							if (version !== heroRevealVersion) return;

							document.documentElement.classList.add('hero-initial-reveal');

							window.setTimeout(() => {
								if (version !== heroRevealVersion) return;

								document.documentElement.classList.remove(
									'hero-initial-load',
									'hero-initial-reveal',
								);
							}, initialHeroFadeDuration);
						});
					});
				}
			};

			const progressElement = () =>
				document.querySelector<HTMLElement>('[data-navigation-progress]');

			const startProgress = () => {
				const progress = progressElement();

				if (!progress) return;

				progress.classList.remove('navigation-progress--complete');
				progress.classList.add('navigation-progress--loading');
			};

			const completeProgress = () => {
				const progress = progressElement();

				if (!progress?.classList.contains('navigation-progress--loading')) return;

				progress.classList.remove('navigation-progress--loading');
				progress.classList.add('navigation-progress--complete');

				const reset = () => {
					progress.classList.remove('navigation-progress--complete');
				};

				progress.addEventListener('transitionend', reset, { once: true });
				window.setTimeout(reset, 150);
			};

			document.addEventListener('click', (event) => {
				const target = event.target;

				if (target instanceof Element && target.closest('#js-open-closed')) {
					document.documentElement.classList.toggle('js-open');
				}
			});

			document.addEventListener('astro:before-preparation', (event) => {
				document.documentElement.classList.remove('js-open');
				document.documentElement.classList.add('page-transition-out');
				startProgress();

				const loadPage = event.loader;
				event.loader = async () => {
					await Promise.all([
						loadPage(),
						new Promise<void>((resolve) => {
							window.setTimeout(resolve, minimumNavigationDuration);
						}),
					]);
				};

				event.signal.addEventListener('abort', () => {
					document.documentElement.classList.remove('page-transition-out');
					completeProgress();
				}, { once: true });
			});

			document.addEventListener('astro:after-swap', () => {
				heroRevealVersion += 1;
				document.documentElement.classList.remove(
					'page-transition-out',
					'hero-initial-reveal',
				);
				document.documentElement.classList.add(
					'font-oswald-loading',
					'hero-initial-load',
				);
			});

			document.addEventListener('astro:page-load', () => {
				completeProgress();
				revealInitialHero();
			});

			revealInitialHero();
		</script>
	</body>
</html>
