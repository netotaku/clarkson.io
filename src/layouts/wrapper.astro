---
import { SITE_TITLE } 		from  '../consts';
import PixelHero from "../components/PixelHero.astro";
import { type CollectionEntry, getCollection } from 'astro:content';
import BlogList from '../components/BlogList.astro';
import NavLinks from '../components/NavLinks.astro';
import '../styles/global.scss';

const today = new Date();

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image } = Astro.props;

const allPosts = await getCollection('blog');


const categoryMap = new Map<
  string,
  {
    slug: string;
    label: string;
    count: number;
  }
>();

const unslugify = (slug: string) =>
  slug
    .replace(/[-_]+/g, ' ')
    .replace(/\b\w/g, (char) => char.toUpperCase());

for (const post of allPosts) {
  for (const slug of post.data.categories ?? []) {
    const existing = categoryMap.get(slug);

    if (existing) {
      existing.count += 1;
    } else {
      categoryMap.set(slug, {
        slug,
        label: unslugify(slug),
        count: 1,
      });
    }
  }
}
const categories = [...categoryMap.values()]
  .sort((a, b) => b.count - a.count);
---

<!doctype html>
<html lang="en-GB">
	<head>
		<!-- Global Metadata -->
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/images/favicon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={SITE_TITLE}
			href={new URL('rss.xml', Astro.site)}
		/>
		<meta name="generator" content="ZX Spectrum 128 +2" />

		<!-- <link
  			rel="stylesheet"
  			href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"
		> -->

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&family=Wire+One&display=swap" rel="stylesheet">
		<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@200..700&display=swap" rel="stylesheet">
		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, Astro.url)} />
		
	</head>
	<body>  
		
		<div class="layer layer--0 nav">
			<div class="nav__section">
				<h2 class="nav__heading">Menu</h2>
				<div class="nav__links">
					<NavLinks />
				</div>				
			</div>
			<div class="nav__section">
				<h2 class="nav__heading">Contact</h2>
				<div class="nav__links">
					<a href="#">WhatsApp</a>
					<a href="#">07771 535 355</a>
					<a href="#">nick@clarkson.io</a>
				</div>				
			</div>				
			<div class="nav__section">
				<h2 class="nav__heading">Social</h2>
				<div class="nav__links">
					<a href="#">Threads</a>
					<a href="#">LinkedIn</a>
					<a href="#">Strava</a>
					<a href="#">Soundcloud</a>
				</div>				
			</div>		
			<div class="nav__section">
				<h2 class="nav__heading"># Topics</h2>
				{categories.map((category) => (
					<a
						href={`/blog/category/${category.slug}/`}
						class="tag tag--stacked"
					>					
						<span class="tag__count">{category.count}</span>
						<span class="tag__label">{category.label}</span>
					</a>
				))}
			</div>			
			<!-- <div class="nav__section grid grid--column">
				<h2 class="nav__heading">Recent Posts</h2>
				<BlogList posts={allPosts} />
			</div> -->
		</div>

		<div class="main">

			<div class="layer layer--1">

				<PixelHero
					src={image}
					topHeight={860}
					pixelPitch={44}
					dotScale={.8}
					cornerRadius={28}				
					backgroundSample="average"
					backgroundMix={0.29}
					parallax={true}
					parallaxSpeed={0.3}
					physics="chunky-collapse"
					physicsOverrides={{
						dissolveStart: 0.6,
					}}
				/>

			</div>

			<div class="layer layer--2">

				<slot />
				
				<footer class="section footer">
					<div class="footer__links">
						<NavLinks />
					</div>
				</footer>

				<menu class="menu">
					<a class="btn btn--hire" href="#">HIRE ME</a>
					<button id="js-open-closed" class="btn btn--open">
						<img src="/src/assets/SVG/burger.svg">
					</button>
				</menu>	

			</div>

		</div> <!-- .main -->

		<script src="https://cdn.counter.dev/script.js" data-id="59f59e50-b01a-493b-a121-d8237b9db371" data-utcoffset="1"></script>
		<script>
			const toggle = document.querySelector('#js-open-closed');

			toggle?.addEventListener('click', () => {
			document.documentElement.classList.toggle('js-open');
			});
		</script>
	</body>
</html>
