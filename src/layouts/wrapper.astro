---
import { SITE_TITLE } from  '../consts';
import type { ImageMetadata } from 'astro';
import { ClientRouter } from 'astro:transitions';
import { execFileSync } from 'node:child_process';
import availableForWorkLabel from '../assets/SVG/Available for work.svg';
import PixelHero from "../components/PixelHero.astro";
import Card from "../components/Card.astro";

import Primary from "../components/nav/primary.astro";
import Secondary from "../components/nav/secondary.astro";
import Social from "../components/nav/social.astro";
import Contact from "../components/nav/contact.astro";

import SignUp from "../components/fragments/SignUp.astro";
import { getCollection } from 'astro:content';
import { getLatestPost } from '../utils/blog';
import { categoryLabel, categorySlug } from '../utils/categories';
import '../styles/global.scss';
import {
  BurgerIcon,
  CloseIcon,
  WhatsappIcon,
  HomeIcon
} from '../icons';

interface Props {
	title?: string;
	description?: string;
	image: string | ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image } = Astro.props;
const shareImageUrl = new URL('/share.jpg', Astro.url);

const allPosts = await getCollection('blog');
const latestPost = await getLatestPost();


const categoryMap = new Map<
  string,
  {
    slug: string;
    label: string;
    count: number;
  }
>();

for (const post of allPosts) {
  for (const category of post.data.categories ?? []) {
    const slug = categorySlug(category);
    const existing = categoryMap.get(slug);

    if (existing) {
      existing.count += 1;
    } else {
      categoryMap.set(slug, {
        slug,
        label: categoryLabel(category),
        count: 1,
      });
    }
  }
}
const categories = [...categoryMap.values()]
  .sort((a, b) => b.count - a.count);

const isCommitSha = (value: string | undefined): value is string =>
	/^[0-9a-f]{40}$/i.test(value ?? '');

const deployedCommit = process.env.COMMIT_REF?.trim();
let buildCommit = isCommitSha(deployedCommit) ? deployedCommit : undefined;

if (!buildCommit && !deployedCommit) {
	try {
		const localCommit = execFileSync('git', ['rev-parse', 'HEAD'], {
			encoding: 'utf8',
		}).trim();

		if (isCommitSha(localCommit)) buildCommit = localCommit;
	} catch {
		// Git may not be available in every local development environment.
	}
}

const buildCommitLabel = buildCommit?.slice(0, 7) ?? 'dev';
const buildCommitUrl = buildCommit
	? `https://github.com/netotaku/clarkson.io/commit/${buildCommit}`
	: undefined;
---
<!doctype html>
<html lang="en-GB" transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<script is:inline>
			document.documentElement.classList.add(
				'font-oswald-loading',
				'hero-initial-load',
			);

		</script>
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={SITE_TITLE}
			href={new URL('rss.xml', Astro.site)}
		/>
		<meta name="generator" content="ZX Spectrum 128 +2" />
		<ClientRouter fallback="swap" />
		<link rel="canonical" href={canonicalURL} />

		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={shareImageUrl} />
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={shareImageUrl} />
		
	</head>
	<body>
		<div
			class="navigation-progress"
			data-navigation-progress
			transition:persist="navigation-progress"
			aria-hidden="true"
		></div>
		
		<nav id="site-menu" class="layer layer--0 nav">
			<div class="nav__section">
				<Primary />
			</div>
			<div class="nav__section">
				<Secondary />
			</div>
			<div class="nav__section">
				<Contact />	
			</div>				
			<div class="nav__section">
				<Social />
			</div>		
			<div class="nav__section">
				<h2 class="nav__heading"># Topics</h2>
				{categories.map((category) => (
					<a
						href={`/blog/category/${category.slug}/`}
						class="tag tag--stacked">					
							<span class="tag__count">{category.count}</span>
							<span class="tag__label">{category.label}</span>
					</a>
				))}
			</div>			
		</nav>

		<div class="main">

			<div class="layer layer--1">

				<PixelHero
					src={image}
					topHeight={1200}
					pixelPitch={44}
					dotScale={.9}
					cornerRadius={28}
					backgroundSample="average"
					backgroundMix={0.29}
					parallax={true}
					parallaxSpeed={0.3}
					physics="chunky-collapse"
					physicsOverrides={{

						dissolveStart: .1,
						erosion: 0.9,
						cohesion: 0.66,
						gravity: 2.25,
						turbulence: 0.04,
						drag: 0.22,
						fragmentDistance: 4000,
						tailOpacity: 1,
						tailFadeCurve: 1,
						seed: 911,

					}}
					
				/>

			</div>
	
			<main class="layer layer--2">

				<slot />
				
				<footer class="section footer">

					<div class="footer__links footer__links--primary">										
						<div class="footer__links__list">
							<Primary />
						</div>
					</div>

					<div class="footer__links">	
						<div class="footer__links__list">
							<Secondary />
						</div>
						<div class="footer__links__list">
							<Social />
						</div>
						<div class="footer__links__list">
							<Contact />
						</div>
						<div class="footer__links__list footer__links__list--latest">
							<h2 class="nav__heading">Latest Post</h2>
							<Card post={latestPost} modifier="--mini" />
						</div>
					</div>
					
					<SignUp />	

					<p class="footer__meta">
						<span class="footer__build">
							<strong>v3</strong> <span>@</span>
							{buildCommitUrl ? (
								<a
									class="footer__commit"
									href={buildCommitUrl}
									target="_blank"
									rel="noopener noreferrer"
									title={`View source at commit ${buildCommit}`}
								>{buildCommitLabel}</a>
							) : (
								<span>{buildCommitLabel}</span>
							)}
						</span>
						<span class="u-no-mobile" aria-hidden="true">·</span><br class="u-mobile-only">
						<a class="footer__cookies" href="/cookies-and-privacy">Cookies &amp; Privacy</a>											
					</p>
					
				</footer>

			</main>

		</div> <!-- .main -->

		<div class="menu-overlay" aria-hidden="true"></div>

		<menu
					class="menu"
					transition:persist="fixed-menu"
				>
					<div class="menu__group">
						<a class="btn btn--icon btn--orange menu__home" href="/">
							<HomeIcon />
						</a>

						<div
							class="btn btn--green menu__availability"
							aria-label="Available for work"
						>
							<span class="btn__circle"></span>
							<img
								class="btn__label"
								src={availableForWorkLabel.src}
								width={availableForWorkLabel.width}
								height={availableForWorkLabel.height}
								alt="Available for work"
								aria-hidden="true"
							/>
						</div>
					</div>
					<div class="menu__group">
						<a target="_blank" class="btn btn--icon btn--green menu__whatsapp" href="https://wa.me/447771535355">
							<WhatsappIcon />
						</a>
				<button
					id="js-open-closed"
					class="btn btn--icon btn--hand"
					type="button"
					aria-label="Toggle menu"
					aria-controls="site-menu"
					aria-expanded="false"
				>
					<span class="menu__burger-icon" aria-hidden="true"><BurgerIcon /></span>
					<span class="menu__close-icon" aria-hidden="true"><CloseIcon /></span>
				</button>
					</div>
		</menu>

		

		<script src="https://cdn.counter.dev/script.js" data-id="59f59e50-b01a-493b-a121-d8237b9db371" data-utcoffset="1"></script>
		<script>
			const pageFadeDuration = 520;
			const initialHeroFadeDuration = pageFadeDuration;
			let heroRevealVersion = 0;

			const waitForPixelHero = () => {
				const pixelHero = document.querySelector<HTMLElement>('[data-pixel-hero]');

				if (!pixelHero || pixelHero.classList.contains('is-ready')) {
					return Promise.resolve();
				}

				return new Promise<void>((resolve) => {
					const finish = () => resolve();

					pixelHero.addEventListener('pixel-hero:ready', finish, { once: true });

					if (pixelHero.classList.contains('is-ready')) {
						pixelHero.removeEventListener('pixel-hero:ready', finish);
						finish();
					}
				});
			};

			const startPageFadeOut = (signal: AbortSignal) => {
				const main = document.querySelector<HTMLElement>('.main');

				if (
					!main ||
					window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
					window.getComputedStyle(main).opacity === '0'
				) {
					document.documentElement.classList.add('page-transition-out');
					return Promise.resolve();
				}

				return new Promise<void>((resolve) => {
					const finish = () => {
						main.removeEventListener('transitionend', onTransitionEnd);
						main.removeEventListener('transitioncancel', finish);
						signal.removeEventListener('abort', finish);
						resolve();
					};
					const onTransitionEnd = (event: TransitionEvent) => {
						if (event.propertyName === 'opacity') finish();
					};

					main.addEventListener('transitionend', onTransitionEnd);
					main.addEventListener('transitioncancel', finish, { once: true });
					signal.addEventListener('abort', finish, { once: true });
					document.documentElement.classList.add('page-transition-out');
				});
			};

			const revealInitialHero = async () => {
				const version = ++heroRevealVersion;

				try {
					await Promise.all([
						document.fonts.load('700 1em Oswald'),
						waitForPixelHero(),
					]);
				} finally {
					if (version !== heroRevealVersion) return;

					document.documentElement.classList.remove(
						'font-oswald-loading',
						'page-transition-out',
					);

					window.requestAnimationFrame(() => {
						if (version !== heroRevealVersion) return;

						window.requestAnimationFrame(() => {
							if (version !== heroRevealVersion) return;

							document.documentElement.classList.add('hero-initial-reveal');

							window.setTimeout(() => {
								if (version !== heroRevealVersion) return;

								document.documentElement.classList.remove(
									'hero-initial-load',
									'hero-initial-reveal',
								);
							}, initialHeroFadeDuration);
						});
					});
				}
			};

			const progressElement = () =>
				document.querySelector<HTMLElement>('[data-navigation-progress]');

			const startProgress = () => {
				const progress = progressElement();

				if (!progress) return;

				progress.classList.remove(
					'navigation-progress--animating',
					'navigation-progress--complete',
				);
				progress.classList.add('navigation-progress--loading');
			};

			const completeProgress = () => {
				const progress = progressElement();

				if (
					!progress?.classList.contains('navigation-progress--loading') &&
					!progress?.classList.contains('navigation-progress--animating')
				) return;

				progress.classList.remove(
					'navigation-progress--loading',
					'navigation-progress--animating',
				);
				progress.classList.add('navigation-progress--complete');

				const reset = () => {
					progress.classList.remove('navigation-progress--complete');
				};

				progress.addEventListener('transitionend', reset, { once: true });
				window.setTimeout(reset, 150);
			};

			const animateProgressWithPageReveal = async () => {
				await waitForPixelHero();

				const progress = progressElement();

				if (!progress?.classList.contains('navigation-progress--loading')) return;

				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
					completeProgress();
					return;
				}

				progress.style.setProperty(
					'--navigation-animation-duration',
					`${pageFadeDuration}ms`,
				);
				progress.classList.remove('navigation-progress--loading');
				progress.classList.add('navigation-progress--animating');

				window.setTimeout(completeProgress, pageFadeDuration);
			};

			const toggleMenu = () => {
					const root = document.documentElement;
					const opening = !root.classList.contains('js-open');
					const toggle = document.querySelector<HTMLElement>('#js-open-closed');

					root.classList.toggle('js-open', opening);
					root.classList.toggle('menu-overlay-visible', opening);
					toggle?.setAttribute('aria-expanded', String(opening));
			};

			document.addEventListener('click', (event) => {
				const target = event.target;

				if (target instanceof Element && target.closest('#js-open-closed')) {
					toggleMenu();
				}
			});

			document.addEventListener('astro:before-preparation', (event) => {
				document.documentElement.classList.remove('js-open');
				document.querySelector('#js-open-closed')?.setAttribute('aria-expanded', 'false');
				startProgress();

				const fadeOutComplete = startPageFadeOut(event.signal);
				const loadPage = event.loader;

				event.loader = async () => {
					await Promise.all([
						loadPage(),
						fadeOutComplete,
					]);
				};

				event.signal.addEventListener('abort', () => {
					document.documentElement.classList.remove('page-transition-out');
					completeProgress();
				}, { once: true });
			});

			document.addEventListener('astro:after-swap', () => {
				heroRevealVersion += 1;
				document.documentElement.classList.remove(
					'hero-initial-reveal',
				);
				document.documentElement.classList.add(
					'font-oswald-loading',
					'hero-initial-load',
				);
			});

			document.addEventListener('astro:page-load', () => {
				document.documentElement.classList.remove('menu-overlay-visible');
				document.querySelector('#js-open-closed')?.setAttribute('aria-expanded', 'false');
				animateProgressWithPageReveal();
				revealInitialHero();
			});

			revealInitialHero();
		</script>
	</body>
</html>
