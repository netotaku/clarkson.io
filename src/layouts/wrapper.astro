---
import { SITE_TITLE } from  '../consts';
import type { ImageMetadata } from 'astro';
import PixelHero from "../components/PixelHero.astro";


import Primary from "../components/nav/primary.astro";
import Secondary from "../components/nav/secondary.astro";
import Social from "../components/nav/social.astro";
import Contact from "../components/nav/contact.astro";



import SignUp from "../components/fragments/SignUp.astro";
import { getCollection } from 'astro:content';
import '../styles/global.scss';
import {
  BurgerIcon,
  WhatsappIcon,
  HomeIcon
} from '../icons';

const today = new Date();

interface Props {
	title?: string;
	description?: string;
	image: string | ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image } = Astro.props;
const imageUrl = typeof image === 'string' ? image : image.src;

const allPosts = await getCollection('blog');


const categoryMap = new Map<
  string,
  {
    slug: string;
    label: string;
    count: number;
  }
>();

const unslugify = (slug: string) =>
  slug
    .replace(/[-_]+/g, ' ')
    .replace(/\b\w/g, (char) => char.toUpperCase());

for (const post of allPosts) {
  for (const slug of post.data.categories ?? []) {
    const existing = categoryMap.get(slug);

    if (existing) {
      existing.count += 1;
    } else {
      categoryMap.set(slug, {
        slug,
        label: unslugify(slug),
        count: 1,
      });
    }
  }
}
const categories = [...categoryMap.values()]
  .sort((a, b) => b.count - a.count);
---
<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/images/favicon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title={SITE_TITLE}
			href={new URL('rss.xml', Astro.site)}
		/>
		<meta name="generator" content="ZX Spectrum 128 +2" />
		<link rel="canonical" href={canonicalURL} />

		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(imageUrl, Astro.url)} />
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(imageUrl, Astro.url)} />
		
	</head>
	<body>  
		
		<nav class="layer layer--0 nav">
			<div class="nav__section">
				<Primary />
			</div>
			<div class="nav__section">
				<Secondary />
			</div>
			<div class="nav__section">
				<Contact />	
			</div>				
			<div class="nav__section">
				<Social />
			</div>		
			<div class="nav__section">
				<h2 class="nav__heading"># Topics</h2>
				{categories.map((category) => (
					<a
						href={`/blog/category/${category.slug}/`}
						class="tag tag--stacked">					
							<span class="tag__count">{category.count}</span>
							<span class="tag__label">{category.label}</span>
					</a>
				))}
			</div>			
		</nav>

		<div class="main">

			<div class="layer layer--1">

				<PixelHero
					src={image}
					topHeight={1200}
					pixelPitch={44}
					dotScale={.8}
					cornerRadius={28}				
					backgroundSample="average"
					backgroundMix={0.29}
					parallax={true}
					parallaxSpeed={0.3}
					physics="chunky-collapse"
					physicsOverrides={{

						dissolveStart: .1,
						erosion: 0.9,
						cohesion: 0.66,
						gravity: 2.25,
						turbulence: 0.04,
						drag: 0.22,
						fragmentDistance: 4000,
						tailOpacity: 1,
						tailFadeCurve: 1,
						seed: 911,

					}}
					
				/>

			</div>

			<main class="layer layer--2">

				<slot />
				
				<footer class="section footer">

					<div class="footer__links footer__links--primary">										
						<div class="footer__links__list">
							<Primary />
						</div>
					</div>

					<div class="footer__links">	
						<div class="footer__links__list">
							<Secondary />
						</div>
						<div class="footer__links__list">
							<Social />
						</div>
						<div class="footer__links__list">
							<Contact />
						</div>
					</div>
					
					<SignUp />	

					<p><a class="footer__cookies" href="/cookies-and-privacy">Cookies &amp; Privacy</a></p>
					
				</footer>

				<menu class="menu">
					<div class="menu__group">

						<a class="btn btn--icon" href="/">
							<HomeIcon />
						</a>

						<div class="btn btn--green">
							<span class="btn__circle"></span> Available for work
						</div>
						

					</div>
					<div class="menu__group">
						<a class="btn btn--icon" href="#">
							<WhatsappIcon />	
						</a>
						<a id="js-open-closed" class="btn btn--icon">
							<BurgerIcon />	
						</a>
					</div>
				</menu>	

			</main>

		</div> <!-- .main -->

		<script src="https://cdn.counter.dev/script.js" data-id="59f59e50-b01a-493b-a121-d8237b9db371" data-utcoffset="1"></script>
		<script>
			const toggle = document.querySelector('#js-open-closed');

			toggle?.addEventListener('click', () => {
			document.documentElement.classList.toggle('js-open');
			});
		</script>
	</body>
</html>
