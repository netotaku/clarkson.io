---
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'email'>['data'];
const { campaign, subject, segment, heading, sentDate, page } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{subject}</title>
        <style>

            body{
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
            }

            @media screen and (max-width: 800px) {

                .about-links{
                    font-size: 28px!important;
                }

                .me{
                    width: 200px!important;
                }

            }            

            @media screen and (max-width: 600px) {


                .me{
                    width: 130px!important;
                }
                
                .leaf{
                    width: 80px;
                }

                .header{
                    height: 130px!important;
                }

                .h2{
                    font-size: 22px!important;
                    padding-top: 20px;
                }

                .h1{
                    font-size: 35px!important;
                }

                .flash{
                    text-align: left!important;
                    font-size: 12px;                                   
                }

                .no-mobile{
                    display: none!important;
                }

                .mobile-only{
                    display: block!important;
                }

                .seasonal-lockup{
                    vertical-align: middle;
                }

                .footer-column {
                    display: block !important;
                    width: 50% !important;
                    float: left !important;
                }

                .menu{
                    width: 100%;
                }



                .footer-bottom{
                    padding-bottom: 8%!important;
                }
            }



        </style>
    </head>
    <body style="padding: 0; margin: 0; font-family: sans-serif; background: #754C11; color: white">
        
        <table cellpadding="0" cellspacing="0" style="width: 100%">
            <tr>
                <td class="flash" bgcolor="#111111" style="text-align: right; color: #aaaaaa; padding-left: 8%">
                    <div style="padding: 8px 12px; padding-left: 0px;">
                        <span class="no-mobile"><strong>{campaign}</strong> |</span>
                        <a style="color: #aaaaaa" title="View this email in your browser" href="{{WebVersionURL}}">View Online</a>
                    </div>
                </td>
            </tr>
            <tr>
                <td bgcolor="#222222" style="color: #ffffff">

                    <table class="header" width="100%" height="150" cellpadding="0" cellspacing="0">
                        <tr>
                            <td style="padding-left: 8%">
                                <h1 class="h1" style="font-weight: normal; padding: 0; margin: 0; font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif; font-size: 48px">NICK CLARKSON</h1>
                                <p style="padding: 0; margin: 0;"><strong>Freelance digital design, development & strategy</strong></p>                
                            </td>
                            <td class="seasonal-lockup" style="padding-right: 8%" valign="middle">
                                <div style="float: right;">
                                    <img width="100" class="leaf" style="display: block;" src="/images/email/octopus/autumn/maple-top.png">
                                    <img width="100" class="leaf mobile-only" style="display: block;" src="/images/email/octopus/autumn/maple-bottom.png">
                                </div>
                            </td>
                        </tr>
                    </table>

                </td>
            </tr>
            <tr>
                <td style="padding-left: 8%; padding-top: 8%">
                    <div style="max-width: 600px">
                        <h2 class="h2" style="line-height: 1.3; margin-top: 0; font-size: 32px;">{heading}</h2>
                        <div style="line-height: 1.6; font-size: 18px; padding-right: 8%">                        
                            <slot />
                            <p><a style="display: inline-block; padding: 8px 22px; background: #f60; color: white; font-weight: bold; border-radius: 8px; text-decoration: none;" href="https://wa.me/447771535355">Let's Talk</a></p>
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <td>

                    <table width="100%" cellpadding="0" cellspacing="0">
                        <tr>                            
                            <td style="padding-right: 8%">
                                <img class="me me--top" style="display: block; float: right; width: 400px" src="/images/email/octopus/autumn/me-top.png">
                            </td>
                        </tr>
                    </table>
  
                </td>
            </tr>      
            <tr>
                <td style="background: #111111">

                    <table width="100%" cellpadding="0" cellspacing="0">
                        <tr>
                            <td style="padding-top: 8%; padding-left: 8%">

                                <span style="display:block; color: #444444"><strong><small>ABOUT ME</small></strong></span>
                                <span class="about-links" style="font-size: 32px; line-height: 1.2; font-family: Impact, Arial, sans-serif; display: block; margin-bottom: 16px;">
                                    <a style="text-decoration: none; color: white; display:block" href="https://clar.ky/who-i-am/">WHO I AM</a><!--[if mso]><br /><![endif]-->
                                    <a style="text-decoration: none; color: white; display:block" href="https://clar.ky/how-i-work/">HOW I WORK</a><!--[if mso]><br /><![endif]-->
                                    <a style="text-decoration: none; color: white; display:block; margin-bottom: 0px" href="https://clar.ky/where-i-fit/">WHERE I FIT</a>
                                </span>

                            </td>                          
                            <td valign="top" style="padding-right: 8%">
                                <img class="me me--bottom" style="display: block; float: right; width: 400px" src="/images/email/octopus/autumn/me-bottom.png">
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" style="padding-left: 8%">

                                <table class="menu" role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse; border-spacing: 0; mso-table-lspace: 0pt; mso-table-rspace: 0pt;">
                                <tr>
                                    <td width="25%" align="left" valign="top" style="width: 25%; padding-bottom: 20px; font-family: Arial, sans-serif; font-size: 16px; line-height: 24px; color: #ffffff;" class="footer-column">
                                        <span style="display:block; color: #444444"><strong><small>MENU</small></strong></span>
                                        <a style="text-decoration: none; color: white; display:block" href="https://clar.ky/cv/">CV</a><!--[if mso]><br /><![endif]-->
                                        <a style="text-decoration: none; color: white; display:block" href="https://clar.ky/blog/">Thoughts</a><!--[if mso]><br /><![endif]-->
                                        <a style="text-decoration: none; color: white; display:block; margin-bottom: 0px" href="https://clar.ky/governance/">AI Governance</a>
                                    </td>
                                    <td width="25%" align="left" valign="top" style="width: 25%; padding-bottom: 20px; font-family: Arial, sans-serif; font-size: 16px; line-height: 24px; color: #ffffff;" class="footer-column">
                                        <span style="display:block; color: #444444"><strong><small>SOCIAL</small></strong></span>
                                        <a style="text-decoration: none; color: white; display:block" href="https://www.threads.com/@clar.ky">Threads</a><!--[if mso]><br /><![endif]-->
                                        <a style="text-decoration: none; color: white; display:block" href="https://github.com/netotaku">GitHub</a><!--[if mso]><br /><![endif]-->
                                        <a style="text-decoration: none; color: white; display:block; margin-bottom: 0px" href="https://www.linkedin.com/in/nicholasclarkson/">LinkedIn</a>
                                    </td>
                                    <td width="25%" align="left" valign="top" style="width: 25%; padding-bottom: 20px; font-family: Arial, sans-serif; font-size: 16px; line-height: 24px; color: #ffffff;" class="footer-column">
                                        <span style="display:block; color: #444444"><strong><small>CONTACT</small></strong></span>
                                        <a style="text-decoration: none; color: white; display:block" href="tel:+447771535355">Phone</a><!--[if mso]><br /><![endif]-->
                                        <a style="text-decoration: none; color: white; display:block" href="https://wa.me/447771535355">WhatsApp</a><!--[if mso]><br /><![endif]-->
                                        <a style="text-decoration: none; color: white; display:block; margin-bottom: 0px" href="mailto:nick@clarkson.io">Email</a>
                                    </td>
                                </tr>
                                </table>

                            </td>
                        </tr>
                        <tr>
                            <td class="footer-bottom" colspan="2" bgcolor="#111111" style="font-family: Arial, sans-serif; line-height: 24px; padding-left: 8%; padding-bottom: 80px; padding-right: 8%; background-color: #111111; color: #444444" class="pad">

                                <p style="margin: 16px 0; margin-top: 0px;">You received this email because you subscribed to my list.<br class="no-mobile">
                                You can <a style="color: #666666" href="{{UnsubscribeURL}}">unsubscribe</a> at any time.</p>

                                {'{{SenderInfo}}'}

                                <p style="margin: 16px 0; margin-bottom: 0px;">Powered by <a style="color: #666666" href="{{RewardsURL}}">EmailOctopus</a></p>

                            </td>
                        </tr>
                    </table>

                </td>
            </tr>                  
        </table>
        
    </body>
</html>
