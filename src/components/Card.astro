---
import type { CollectionEntry } from 'astro:content';
import Header from './fragments/Header.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  modifier?: string;
}

const { post, modifier } = Astro.props;
const isMicro = modifier === '--micro';
---

<article class:list={['card', modifier && `card${modifier}`]}>
  <Header
    post={post}
    showDescription={!isMicro}
    showTags={!isMicro}
  />
</article>
