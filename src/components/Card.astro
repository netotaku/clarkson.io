---
import FormattedDate from './FormattedDate.astro';
import { Image } from 'astro:assets';

const { data } = Astro.props;

const { post, heroUrl } = data;
const { id, data: postData } = post;
---

<a
  class="card"
  href={`/blog/${id}/`}
  style={`--card-bg: url("${data.optimizedHero}")`}
>
  <article class="card__layout">

      <div class="card__eyebrow">
        <span class="card__date">
          <Image
            src={postData.heroImage}
            alt={postData.title}
            fit="cover" 
            position="center"     
            width={40}  
            height={40} 
            class="card__image"       
          />
        </span>
        <FormattedDate date={postData.pubDate} />
      </div>

      <h2 class="card__title">
        {postData.title}
      </h2>

      <p class="card__desc">
        {postData.description}
      </p>

      <div class="card__tags">
        {postData.categories?.map((category) => (
            <span class="tag">
              <span class="tag__count">#</span>
              <span class="tag__label">{category}</span>
            </span>
        ))}
      </div>      

  </article>
</a>