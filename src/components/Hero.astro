---
import type { ImageMetadata } from 'astro';
import { ArrowIcon } from '../icons';

interface BreadcrumbItem {
  label: string;
  href?: string;
  previous?: boolean;
  next?: boolean;
}

interface Props {
  backgroundImage: ImageMetadata;
  breadcrumb?: string | BreadcrumbItem[];
  title: string;
}

const { backgroundImage, breadcrumb, title } = Astro.props;
const hasBreadcrumbSlot = Astro.slots.has('breadcrumb');
const breadcrumbText = typeof breadcrumb === 'string' ? breadcrumb.trim() : '';
const isSafeHref = (href: string) =>
  /^(?:\/|#|https?:\/\/|mailto:)/i.test(href);
const breadcrumbItems = Array.isArray(breadcrumb)
  ? breadcrumb
      .filter(
        (item): item is BreadcrumbItem =>
          typeof item === 'object' &&
          item !== null &&
          typeof item.label === 'string' &&
          item.label.trim().length > 0,
      )
      .map((item) => ({
        label: item.label.trim(),
        href:
          typeof item.href === 'string' && isSafeHref(item.href)
            ? item.href
            : undefined,
        previous: item.previous === true,
        next: item.next === true,
      }))
  : [];
const hasBreadcrumb =
  hasBreadcrumbSlot || breadcrumbText.length > 0 || breadcrumbItems.length > 0;
---

<header
  class="hero"
  style={`--hero-image: url("${backgroundImage.src}"); --hero-image-width: ${backgroundImage.width}px; --hero-image-height: ${backgroundImage.height}px;`}
>
  <div class="hero__title">
    {
      hasBreadcrumb && (
        <nav class="hero__breadcrumb" aria-label="Breadcrumb">
          {hasBreadcrumbSlot ? (
            <slot name="breadcrumb" />
          ) : breadcrumbItems.length > 0 ? (
            breadcrumbItems.map((item) => (
              <span class="hero__breadcrumb-item">
                {item.previous && (
                  <ArrowIcon class="hero__breadcrumb-icon" />
                )}
                {item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
                {item.next && (
                  <ArrowIcon class="hero__breadcrumb-icon hero__breadcrumb-icon--next" />
                )}
              </span>
            ))
          ) : (
            breadcrumbText
          )}
        </nav>
      )
    }
    <h1>{title}</h1>
  </div>
</header>
