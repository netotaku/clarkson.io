<form
    class="form"
    action="/.netlify/functions/subscribe"
    method="post"
    data-astro-reload
    data-signup-form
    data-state="idle"
>
    <h2 class="eyebrow">Sign up</h2>

    <div class="form__fieldset">
        <input
            class="form form__text-input form__text-input--email"
            aria-label="Email address"
            placeholder="Email address"
            type="email"
            name="email"
            autocomplete="email"
            required
        >

        <input
            type="submit"
            class="form__button"
            value="Subscribe"
        >

    </div>

    <p class="form__status" data-signup-status role="status" aria-live="polite" hidden></p>

    <div class="form__small-print">
        <p>
            By submitting this form, you agree to join our mailing list.<br class="u-no-mobile">
            You can unsubscribe at any time using the link in the footer of our emails.            
        </p>
    </div>

</form>

<script>
    const initialiseSignupForms = () => {
        document.querySelectorAll<HTMLFormElement>('[data-signup-form]').forEach((form) => {
            if (form.dataset.signupInitialised === 'true') return;

            form.dataset.signupInitialised = 'true';
            const emailInput = form.querySelector<HTMLInputElement>('input[type="email"]');
            const submitInput = form.querySelector<HTMLInputElement>('input[type="submit"]');
            const status = form.querySelector<HTMLElement>('[data-signup-status]');

            if (!emailInput || !submitInput || !status) return;

            const requestedPreviewState = import.meta.env.DEV
                ? new URLSearchParams(window.location.search).get('signup-state')
                : null;

            emailInput.addEventListener('focus', () => {
                if (form.dataset.state !== 'error' && form.dataset.state !== 'success') return;

                form.dataset.state = 'idle';
                submitInput.disabled = false;
                submitInput.value = 'Subscribe';
                status.textContent = '';
                status.hidden = true;
            });

            if (requestedPreviewState === 'success' || requestedPreviewState === 'error') {
                form.dataset.state = requestedPreviewState;
                form.dataset.signupPreview = requestedPreviewState;
                status.hidden = false;

                if (requestedPreviewState === 'success') {
                    submitInput.disabled = true;
                    submitInput.value = 'Subscribed';
                    status.textContent = 'Thanks — your signup has been received.';
                } else {
                    status.textContent = 'Sorry, we could not complete your signup. Please try again.';
                }

                return;
            }

            form.addEventListener('submit', async (event) => {
                event.preventDefault();

                if (form.dataset.state === 'submitting') return;

                if (!form.reportValidity()) return;

                form.dataset.state = 'submitting';
                submitInput.disabled = true;
                submitInput.value = 'Subscribing…';
                status.hidden = true;
                status.textContent = '';

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ email: emailInput.value }),
                    });

                    if (!response.ok) throw new Error('Subscription request failed');

                    form.dataset.state = 'success';
                    emailInput.value = '';
                    submitInput.value = 'Subscribed';
                    status.textContent = 'Thanks — your signup has been received.';
                    status.hidden = false;
                } catch {
                    form.dataset.state = 'error';
                    submitInput.disabled = false;
                    submitInput.value = 'Subscribe';
                    status.textContent = 'Sorry, we could not complete your signup. Please try again.';
                    status.hidden = false;
                }
            });
        });
    };

    initialiseSignupForms();
    document.addEventListener('astro:page-load', initialiseSignupForms);
</script>
