---
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

type BlogPost = CollectionEntry<'blog'>;

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;

const optimizedPosts = await Promise.all(
  posts.map(async (post) => {
    const image = await getImage({
      src: post.data.heroImage,
      width: 900,
      format: 'webp',
      quality: 75,
    });

    return {
      post,
      heroUrl: image.src,
    };
  })
);
---

<div class="masonry" data-masonry>
  {
    optimizedPosts.map(({ post, heroUrl }, index) => (
      <a
        class:list={[
          'masonry__item',
          index === 0 && 'masonry__item--featured',
        ]}
        href={`/blog/${post.id}/`}
        data-masonry-item
      >
        <article
          class="masonry__card"
          style={`--card-image: url("${heroUrl}")`}
        >
          <div class="masonry__content">
            <span class="masonry__date">
              <FormattedDate date={post.data.pubDate} />
            </span>

            <h2>{post.data.title}</h2>

            <p>{post.data.description}</p>

            {/* <div class="tags">
              {post.data.categories?.map((category) => (
                <span class="tag">
                    <span class="tag__count">#</span> 
                    <span class="tag__label">{category}</span>
                </span>
              ))}
            </div> */}
          </div>
        </article>
      </a>
    ))
  }
</div>

<script>
  const initialiseMasonry = () => {
    document.querySelectorAll('[data-masonry]').forEach((grid) => {
      if (!(grid instanceof HTMLElement)) return;

      const resize = () => {
        const styles = getComputedStyle(grid);

        const rowHeight =
          parseInt(styles.getPropertyValue('grid-auto-rows')) || 10;

        const rowGap =
          parseInt(styles.getPropertyValue('row-gap')) || 0;

        grid.querySelectorAll('[data-masonry-item]').forEach((item) => {
          if (!(item instanceof HTMLElement)) return;

          item.style.gridRowEnd = 'auto';

          const height = item.getBoundingClientRect().height;

          const span = Math.ceil(
            (height + rowGap) / (rowHeight + rowGap)
          );

          item.style.gridRowEnd = `span ${span}`;
        });
      };

      resize();

      const observer = new ResizeObserver(resize);
      observer.observe(grid);

      grid.querySelectorAll('[data-masonry-item]').forEach((item) => {
        observer.observe(item);
      });
    });
  };

  initialiseMasonry();

  document.addEventListener(
    'astro:page-load',
    initialiseMasonry
  );
</script>

<style lang="scss">
  .masonry {
    --masonry-gap: var(--gutter, 20px);

    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 10px;

    column-gap: var(--masonry-gap);
    row-gap: var(--masonry-gap);

    align-items: start;

    &__item {
      display: block;
      min-width: 0;

      color: inherit;
      text-decoration: none;

      &--featured {
        grid-column: span 2;
      }
    }

    &__card {
      position: relative;
      overflow: hidden;

      min-height: 320px;
      border-radius: 20px;

      background-image:
        linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0.05),
          rgba(0, 0, 0, 0.7)
        ),
        var(--card-image);

      background-size: cover;
      background-position: center;

      display: flex;
      align-items: flex-end;

      h2{
        font-family: Oswald;
        text-transform: uppercase;
        line-height: 1.2;
        font-size: 40px;
      }
    }

    /*
     * Give the cards some deliberate variation.
     * This creates the masonry rhythm rather than
     * every article having the same height.
     */

    &__item:nth-child(4n + 1) .masonry__card {
      min-height: 460px;
    }

    &__item:nth-child(4n + 2) .masonry__card {
      min-height: 300px;
    }

    &__item:nth-child(4n + 3) .masonry__card {
      min-height: 390px;
    }

    &__item:nth-child(4n + 4) .masonry__card {
      min-height: 340px;
    }

    &__item--featured .masonry__card {
      min-height: 460px;
    }

    &__content {
      width: 100%;
      padding: var(--gutter); // clamp(20px, 3vw, 40px);
      display: flex;
      flex-direction: column;
      gap: var(--gutter);
    }

    &__date {
      display: block;
      font-weight: bold;
    }

    h2 {
      margin: 0;

      font-family: Oswald;
      line-height: 0.95;
      text-wrap: balance;
    }

    p {
      max-width: 45ch;      
    }


    @media (max-width: 1100px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));

      &__item--featured {
        grid-column: span 2;
      }
    }

    @media (max-width: 760px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));

      &__item--featured {
        grid-column: span 2;
      }
    }

    @media (max-width: 520px) {
      display: block;

      &__item {
        margin-bottom: var(--masonry-gap);
      }

      &__card {
        min-height: 320px !important;
      }

      &__item--featured .masonry__card {
        min-height: 420px !important;
      }
    }
  }
</style>