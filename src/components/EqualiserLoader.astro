---
const columns = [1, 3, 2, 4, 5];
---

<div class="eq-loader" transition:persist="equaliser-loader" aria-hidden="true">
  {columns.map((height, index) => (
    <span
      class="eq-loader__column"
      style={`--rest-cut: ${5 - height}; --phase: ${index * -0.37}s;`}
    >
      {Array.from({ length: 5 }, () => <span class="eq-loader__block" />)}
    </span>
  ))}
</div>

<style>
  .eq-loader {
    /* Size, spacing, opacity and tempo are intentionally kept together. */
    --eq-scale: 1;
    --eq-block-width: 10px;
    --eq-block-height: var(--eq-block-width);
    --eq-gap: 3px;
    --eq-step: calc(var(--eq-block-height) + var(--eq-gap));
    --eq-opacity: 0.05;
    --eq-speed: 2.4s;

    position: fixed;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) scale(var(--eq-scale));
    /* .main is a later sibling with a transform and an opaque background. */
    z-index: 0;
    display: flex;
    gap: var(--eq-gap);
    color: rgb(255 255 255 / var(--eq-opacity));
    pointer-events: none;
  }

  .eq-loader__column {
    display: flex;
    flex-direction: column;
    gap: var(--eq-gap);
    clip-path: inset(calc(var(--rest-cut) * var(--eq-step)) 0 0);
    animation: eq-pump var(--eq-speed) steps(1, end) var(--phase) infinite;
  }

  .eq-loader__block {
    width: var(--eq-block-width);
    height: var(--eq-block-height);
    border-radius: 2px;
    background: currentColor;
  }

  /* Each cut falls in a gap, revealing only whole blocks. */
  @keyframes eq-pump {
    0%, 100% { clip-path: inset(calc(3 * var(--eq-step)) 0 0); }
    15% { clip-path: inset(calc(1 * var(--eq-step)) 0 0); }
    30% { clip-path: inset(calc(2 * var(--eq-step)) 0 0); }
    45% { clip-path: inset(0 0 0); }
    60% { clip-path: inset(calc(1 * var(--eq-step)) 0 0); }
    75% { clip-path: inset(calc(4 * var(--eq-step)) 0 0); }
    90% { clip-path: inset(calc(2 * var(--eq-step)) 0 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .eq-loader__column {
      animation: none;
    }
  }
</style>
