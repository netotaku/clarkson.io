---
import "../styles/counter.scss"
---
<div title="Hits" class="counter" data-hit-counter data-hit-counter-state="loading" aria-busy="true" aria-live="polite">
  <span class="counter__total" data-hit-counter-total aria-label="Loading site views"></span>
  <svg class="counter__sparkline" data-hit-counter-sparkline viewBox="0 0 300 80" role="img" aria-label="Monthly site views" data-loaded="false">
    <desc>Monthly site views are loading.</desc>
    <path fill="none" stroke="var(--hit-counter-line-color, #ff7900)" stroke-width="var(--hit-counter-line-width, 1.5)" vector-effect="non-scaling-stroke" />
  </svg>
</div>

<script>
  import '../scripts/hit-counter';
</script>
