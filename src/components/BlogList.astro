---
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
  title?: string;
  modifier?: string;
}

const { posts, title, modifier } = Astro.props;
---

{
  title && <h1 class="blog-list__title">{title}</h1>
}

<ul class:list={['blog-list', modifier]}>
  {
    posts.map((post) => (
      <li class="blog-list__item">
        <Card post={post} />
      </li>
    ))
  }
</ul>
