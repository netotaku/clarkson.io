---
import type { ImageMetadata } from 'astro';
import type { PhysicsConfig } from '../pixel/types';
import {
  physicsPresets,
  defaultPhysicsPreset,
  type PhysicsPresetName,
} from '../pixel/config';
import '../styles/pixelHero.scss';

interface Props {
  src: string | ImageMetadata;
  alt?: string;

  topHeight?: number;

  pixelPitch?: number;
  dotScale?: number;
  cornerRadius?: number;

  saturation?: number;
  contrast?: number;

  backgroundSample?: 'average' | 'top' | 'bottom' | 'centre';
  backgroundMix?: number;

  parallax?: boolean;
  parallaxSpeed?: number;

  /** Entrance timings in milliseconds. */
  entranceStagger?: number;
  entranceDuration?: number;
  entranceDelay?: number;

  /**
   * Pick one of the built-in physics presets.
   *
   * Defaults to "heavy-gravity".
   */
  physics?: PhysicsPresetName;

  /**
   * Optional per-instance changes applied on top of the chosen preset.
   */
  physicsOverrides?: Partial<PhysicsConfig>;

  class?: string;
}

const {
  src,
  alt = '',

  topHeight = 600,

  pixelPitch = 18,
  dotScale = 0.44,
  cornerRadius = 24,

  saturation = 1,
  contrast = 1,

  backgroundSample = 'average',
  backgroundMix = 0.29,

  parallax = true,
  parallaxSpeed = 0.08,

  entranceStagger = 1600,
  entranceDuration = 400,
  entranceDelay = 0,

  physics = defaultPhysicsPreset,
  physicsOverrides = {},

  class: className = '',
} = Astro.props;

const imageSrc =
  typeof src === 'string'
    ? src
    : src.src;

const resolvedPhysics: PhysicsConfig = {
  ...physicsPresets[physics],
  ...physicsOverrides,
};
---

<div
  class:list={[
    'pixel-hero',
    className,
  ]}
  data-pixel-hero
  data-top-height={topHeight}
  data-pixel-pitch={pixelPitch}
  data-dot-scale={dotScale}
  data-corner-radius={cornerRadius}
  data-saturation={saturation}
  data-contrast={contrast}
  data-background-sample={backgroundSample}
  data-background-mix={backgroundMix}
  data-parallax={parallax}
  data-parallax-speed={parallaxSpeed}
  data-entrance-stagger={entranceStagger}
  data-entrance-duration={entranceDuration}
  data-entrance-delay={entranceDelay}
  data-physics={JSON.stringify(resolvedPhysics)}
  role="img"
  aria-label={alt}
>
  <img
    class="pixel-hero__source"
    src={imageSrc}
    alt=""
    crossorigin="anonymous"
    loading="eager"
    decoding="async"
  />

  <div
    class="pixel-hero__parallax"
    data-parallax-layer
  >
    <svg
      class="pixel-hero__svg"
      data-pixel-svg
      preserveAspectRatio="xMinYMin meet"
      aria-hidden="true"
    ></svg>
  </div>
</div>

<script>
  import '../scripts/pixelHero';
</script>
